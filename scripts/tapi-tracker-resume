#!/usr/bin/env bash
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=/dev/null
source "$HERE/tapi-flow-lib.sh"

tracker="$(assert_in_tracker)"
current="$(git rev-parse --abbrev-ref HEAD)"

case "$current" in
  feature/*|hotfix/*) fail "active issue branch $current; finish first" ;;
esac

ff_base_branch develop
if [[ "$current" != "$tracker" ]]; then
  git checkout -q "$tracker"
fi
git rebase -q develop || fail "rebase on develop failed; resolve and rerun"
summarize "resumed tracker $tracker @ develop tip"
