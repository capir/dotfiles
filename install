#!/bin/zsh

DOTFILES="$(cd "$(dirname "$0")" && pwd)"

# Neovim config
rm -rf "$HOME/.config/nvim"
ln -s "$DOTFILES/nvim" "$HOME/.config/nvim"

# Kitty config
rm -rf "$HOME/.config/kitty"
ln -s "$DOTFILES/kitty" "$HOME/.config/kitty"

# Ghostty config (the macOS App Support template would load after XDG, so drop it)
rm -rf "$HOME/.config/ghostty"
ln -s "$DOTFILES/ghostty" "$HOME/.config/ghostty"
rm -f "$HOME/Library/Application Support/com.mitchellh.ghostty/config.ghostty"

# Tmux config
mkdir -p "$HOME/.tmux"
rm -rf "$HOME/.tmux.conf" "$HOME/.tmux/plugins"
ln -s "$DOTFILES/tmux/tmux.conf" "$HOME/.tmux.conf"
ln -s "$DOTFILES/tmux/plugins" "$HOME/.tmux/plugins"

# hledger config
mkdir -p "$HOME/.config/hledger/"
rm -rf "$HOME/.config/hledger/hledger.conf"
ln -s "$DOTFILES/hledger/hledger.conf" "$HOME/.config/hledger/hledger.conf"

# mycli config
rm -rf "$HOME/.myclirc"
ln -s "$DOTFILES/mycli/.myclirc" "$HOME/.myclirc"

# lazysql config (saved_queries stays local)
mkdir -p "$HOME/.config/lazysql"
rm -rf "$HOME/.config/lazysql/config.toml"
ln -s "$DOTFILES/lazysql/config.toml" "$HOME/.config/lazysql/config.toml"

# sqlit config (only connections.json is tracked; see sqlit/.gitignore)
rm -rf "$HOME/.config/sqlit"
ln -s "$DOTFILES/sqlit" "$HOME/.config/sqlit"

# gpg-agent config (pinentry-mac); restart the agent to pick up changes
mkdir -p "$HOME/.gnupg"
chmod 700 "$HOME/.gnupg"
rm -rf "$HOME/.gnupg/gpg-agent.conf"
ln -s "$DOTFILES/gnupg/gpg-agent.conf" "$HOME/.gnupg/gpg-agent.conf"
gpgconf --kill gpg-agent

# aider config
rm -rf "$HOME/.aider.conf.yml"
rm -rf "$HOME/.aider.model.settings.yml"
ln -s "$DOTFILES/aider/config.yml" "$HOME/.aider.conf.yml"
# ln -s "$DOTFILES/aider/config.yml" "$HOME/.aider.model.settings.yml"

# zsh config
rm -rf "$HOME/.zshrc"
ln -s "$DOTFILES/zshrc" "$HOME/.zshrc"

# taskwarrior config
rm -rf "$HOME/.taskrc"
ln -s "$DOTFILES/taskwarrior/taskrc" "$HOME/.taskrc"
mkdir -p "$HOME/.config/taskopen"
rm -rf "$HOME/.config/taskopen/taskopenrc"
ln -s "$DOTFILES/taskwarrior/taskopenrc" "$HOME/.config/taskopen/taskopenrc"
mkdir -p "$HOME/.config/bugwarrior"
rm -rf "$HOME/.config/bugwarrior/bugwarriorrc"
ln -s "$DOTFILES/taskwarrior/bugwarriorrc" "$HOME/.config/bugwarrior/bugwarriorrc"

# Local scripts
mkdir -p "$HOME/.local/bin"

rm -rf "$HOME/.local/bin/ts"
ln -s "$DOTFILES/scripts/ts" "$HOME/.local/bin/ts"

rm -rf "$HOME/.local/bin/vimwiki-sync.sh"
ln -s "$DOTFILES/scripts/vimwiki-sync.sh" "$HOME/.local/bin/vimwiki-sync.sh"

rm -rf "$HOME/.local/bin/invoice"
ln -s "$DOTFILES/scripts/invoice.sh" "$HOME/.local/bin/invoice"

rm -rf "$HOME/.local/bin/video_label"
ln -s "$DOTFILES/scripts/video/label_video.sh" "$HOME/.local/bin/video_label"

rm -rf "$HOME/.local/bin/video_stack"
ln -s "$DOTFILES/scripts/video/stack_video.sh" "$HOME/.local/bin/video_stack"

rm -rf "$HOME/.local/bin/video_info"
ln -s "$DOTFILES/scripts/video/info_video.sh" "$HOME/.local/bin/video_info"

rm -rf "$HOME/.local/bin/syncWork"
ln -s "$DOTFILES/scripts/syncWork.sh" "$HOME/.local/bin/syncWork"

rm -rf "$HOME/.local/bin/pdfshrink"
ln -s "$DOTFILES/scripts/pdfshrink.sh" "$HOME/.local/bin/pdfshrink"

rm -rf "$HOME/.local/bin/tmux_timew_status"
rm -rf "$HOME/.local/bin/tmux_timew_status_block"
ln -s "$DOTFILES/scripts/tmux_timew_status.sh" "$HOME/.local/bin/tmux_timew_status"
ln -s "$DOTFILES/scripts/tmux_timew_status_block.sh" "$HOME/.local/bin/tmux_timew_status_block"

rm -rf "$HOME/.local/bin/m"
ln -s "$DOTFILES/scripts/mycli_pass.sh" "$HOME/.local/bin/m"

rm -rf "$HOME/.local/bin/car_maintenance"
ln -s "$DOTFILES/scripts/maintenance_tracker" "$HOME/.local/bin/car_maintenance"

rm -rf "$HOME/.local/bin/fin_sold"
ln -s "$DOTFILES/scripts/finance/sold" "$HOME/.local/bin/fin_sold"

rm -rf "$HOME/.local/bin/factcheck_video"
ln -s "$DOTFILES/scripts/factcheck_video.sh" "$HOME/.local/bin/factcheck_video"

rm -rf "$HOME/.local/bin/jview"
ln -s "$DOTFILES/scripts/jview.sh" "$HOME/.local/bin/jview"

rm -rf "$HOME/.local/bin/mgcli"
ln -s "$DOTFILES/scripts/mgcli.sh" "$HOME/.local/bin/mgcli"

rm -rf "$HOME/.local/bin/timew-backup"
ln -s "$DOTFILES/scripts/timew-backup" "$HOME/.local/bin/timew-backup"

rm -rf "$HOME/.local/bin/decrypt-pdfs"
ln -s "$DOTFILES/scripts/decrypt-pdfs.sh" "$HOME/.local/bin/decrypt-pdfs"

rm -rf "$HOME/.local/bin/upload-commit"
ln -s "$DOTFILES/scripts/upload-commit.sh" "$HOME/.local/bin/upload-commit"

for n in note-gen note-link note-refine note-save; do
  rm -rf "$HOME/.local/bin/$n"
  ln -s "$DOTFILES/scripts/$n" "$HOME/.local/bin/$n"
done

# Ghostty CLI (+list-themes, +validate-config, ...); launch the app with `open -na Ghostty`
rm -rf "$HOME/.local/bin/ghostty"
ln -s "/Applications/Ghostty.app/Contents/MacOS/ghostty" "$HOME/.local/bin/ghostty"

rm -rf "$HOME/.local/bin/db_pass_urlenc"
ln -s "$DOTFILES/scripts/db_pass_urlenc.sh" "$HOME/.local/bin/db_pass_urlenc"

rm -rf "$HOME/.local/bin/vault"
ln -s "$DOTFILES/scripts/vault" "$HOME/.local/bin/vault"

rm -rf "$HOME/.local/bin/fin_dash" "$HOME/.local/bin/fin_dash-html"
ln -s "$DOTFILES/scripts/fin_dash" "$HOME/.local/bin/fin_dash"
ln -s "$DOTFILES/scripts/fin_dash-html" "$HOME/.local/bin/fin_dash-html"

rm -rf "$HOME/.local/bin/record_meeting"
ln -s "$DOTFILES/scripts/record_meeting.sh" "$HOME/.local/bin/record_meeting"

rm -rf "$HOME/.local/bin/openai-rate"
ln -s "$DOTFILES/scripts/openai-rate.py" "$HOME/.local/bin/openai-rate"

rm -rf "$HOME/.local/bin/digimount" "$HOME/.local/bin/digiumount"
ln -s "$DOTFILES/scripts/digimount.pl" "$HOME/.local/bin/digimount"
ln -s "$DOTFILES/scripts/digiumount.pl" "$HOME/.local/bin/digiumount"

# Oh-my-zsh custom: zshrc sets ZSH_CUSTOM="$HOME/dotfiles/omz_custom" directly,
# so no symlink is needed (rm -rf "$ZSH_CUSTOM" here would delete omz_custom).

# Aliases
rm -rf "$HOME/.aliases"
ln -s "$DOTFILES/.aliases" "$HOME/.aliases"

# Phpactor config
rm -rf "$HOME/.config/phpactor"
ln -s "$DOTFILES/phpactor" "$HOME/.config/phpactor"

# Zsh completion init
autoload -Uz compinit
compinit
